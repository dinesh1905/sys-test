{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
       {
            "label": "generate_robot_argument_file_windows",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File", "${workspaceFolder}\\.vscode\\generate_robot_argument_file.ps1",
                "-WorkspaceFolder", "\"${workspaceFolder}\"",
                "-FileBaseName",  "\"${fileBasenameNoExtension}\""
            ]
        },
        {
            "label": "generate_robot_argument_file_linux",
            "args": [
               "${workspaceFolder}",
               "${fileBasenameNoExtension}"
            ],
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/generate_robot_argument_file.sh"
         }
    ]
}