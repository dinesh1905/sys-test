  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d20367", 1, 00);
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Disabling CNTR Freeze Failure for CANGL1NonOPMMASWKeepAwakeReqMain");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  SeqCoun_Crpt_disable(Crc_CrptFIT_DataSet, "MaaS_CAN_Interblade_GL1_2::VectorSimulationNode::OPMM_ASW_KeepAwake_Req_Main", "ISG_ASW_KeepAwake_Req_Main");
  testWaitForTimeout(2000);
  
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Checking DTC Status is Inactive");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d20367", 0, 00);
  testWaitForTimeout(2000);
  
}

testfunction EnvD_SysQual_Diagnostic_CommunicationProtection_CANGL1NonOPMMASWKeepAwakeReqMainCNTRRandomFaultInjection()
{
  long result;
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Setting Attribute - CNTR Random");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Set_Attribute(DisturbChecksum_Type, Random, -1, 500); 
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Injecting CNTR Random Failure for CANGL1NonOPMMASWKeepAwakeReqMain");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  result = SeqCoun_Crpt_enable(Crc_CrptFIT_DataSet, "MaaS_CAN_Interblade_GL1_2::VectorSimulationNode::OPMM_ASW_KeepAwake_Req_Main", "ISG_ASW_KeepAwake_Req_Main");
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Checking DTC Status is Active");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d20367", 1, 00);
  testWaitForTimeout(2000);
  
  Check_DTC_Logged(255, "d20365", 1, 00);
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Disabling CNTR Random Failure for CANGL1NonOPMMASWKeepAwakeReqMain");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  SeqCoun_Crpt_disable(Crc_CrptFIT_DataSet, "MaaS_CAN_Interblade_GL1_2::VectorSimulationNode::OPMM_ASW_KeepAwake_Req_Main", "ISG_ASW_KeepAwake_Req_Main");
  testWaitForTimeout(2000);
  
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Checking DTC Status is Inactive");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d20367", 0, 00);
  testWaitForTimeout(2000);
  
  Check_DTC_Logged(255, "d20365", 0, 00);
  testWaitForTimeout(2000);
  
}