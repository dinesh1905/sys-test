testfunction FaultInjectionTemplate()
{
  //TestValidateSystemCallWithExitCode("", "D:\\SW\\Relay\\USBRelayExtLib\\USBRelayExtLib\\TestAppCode\\GuiApp_English\\Power_OnOff.bat", 18000,0);  
  //testWaitForTimeout(60000);
  @sysvar::IL::Klemme15 = 0;
  @sysvar::IL::StartWithoutSending = 0;
  testWaitForTimeout(3000);
  @sysvar::IL::Klemme15 = 1;
  @sysvar::IL::StartWithoutSending = 1;
  
  Check_DTC_Logged(255, "d2031c", 0, 00);
  testWaitForTimeout(2000);
  Check_DTC_Logged(255, "d2031d", 0, 00);
  testWaitForTimeout(2000);
  Check_DTC_Logged(255, "d2031e", 0, 00);
  testWaitForTimeout(2000);
}

testfunction EnvD_SysQual_Diagnostic_CommunicationProtection_OPMMPowerCRCFreezeFaultInjection()
{
  long result;
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Setting Attribute - CRC Freeze");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Set_Attribute(DisturbChecksum_Type, Freeze, -1, 500); 
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Injecting CRC Freeze Failure for OPMM_Power");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  result = CRC_Crpt_enable(Crc_CrptFIT_DataSet, "MaaS_CAN_Interblade_1::VectorSimulationNode::OPMM_Power", "ISG_OPMM_Power");
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Checking DTC Status is Active");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d2031d", 1, 00);
  testWaitForTimeout(2000);
  
  Check_DTC_Logged(255, "d2031e", 1, 00);
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Disabling CRC Freeze Failure for OPMM_Power");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  CRC_Crpt_disable(Crc_CrptFIT_DataSet, "MaaS_CAN_Interblade_1::VectorSimulationNode::OPMM_Power", "ISG_OPMM_Power");
  testWaitForTimeout(2000);
  
  TestStep("", "----------------------------------------------------------------------------------------------------");
  TestStep("", "Checking DTC Status is InActive");
  TestStep("", "----------------------------------------------------------------------------------------------------");
  Check_DTC_Logged(255, "d2031d", 0, 00);
  testWaitForTimeout(2000);
  
  Check_DTC_Logged(255, "d2031e", 0, 00);
  testWaitForTimeout(2000);
  
  
}

